{
  "name": "ai-code-wisdom",
  "version": "0.2.0",
  "private": true,
  "description": "ユーザーが選んだ設計スタイルを、AI が開発から保守まで守り続けるための原則パック・検査・Claude Code プラグイン",
  "type": "module",
  "bin": {
    "wisdom": "bin/wisdom"
