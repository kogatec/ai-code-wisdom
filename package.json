{
  "name": "torus-code",
  "version": "0.3.0",
  "private": true,
  "description": "Principle packs, automated checks, and a Claude Code plugin that keep AI coding agents true to the design style you choose, from development through maintenance",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kogatec/torus-code.git"
  },
  "type": "module",
  "bin": {
    "torus": "bin/torus"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "test:rules": "node scripts/test-rules.ts",
    "typecheck": "tsc -p tsconfig.json",
    "eval": "node eval/run.ts"
  },
  "dependencies": {
    "@ast-grep/cli": "0.45.3",
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "typescript": "6.0.3"
  }
}
